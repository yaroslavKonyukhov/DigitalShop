{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Yarp": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ReverseProxy": {
        "Routes": {
            "identity-route": {
                "ClusterId": "identity-cluster",
                "Match": { "Path": "/api/identity/{**remainder}" }
            },
            "catalog-route": {
                "ClusterId": "catalog-cluster",
                "Match": { "Path": "/api/catalog/{**remainder}" }
            },
            "ordering-route": {
                "ClusterId": "ordering-cluster",
                "Match": { "Path": "/api/ordering/{**remainder}" }
            }
        },
        "Clusters": {
            "identity-cluster": {
                "HttpClient": { "DangerousAcceptAnyServerCertificate": true },
                "Destinations": {
                    "destination1": { "Address": "https://localhost:7203/" }
                }
            },
            "catalog-cluster": {
                "HttpClient": { "DangerousAcceptAnyServerCertificate": true },
                "Destinations": {
                    "destination1": { "Address": "https://localhost:7291/" }
                }
            },
            "ordering-cluster": {
                "HttpClient": { "DangerousAcceptAnyServerCertificate": true },
                "Destinations": {
                    "destination1": { "Address": "https://localhost:7171/" }
                }
            }
        }
    }
}